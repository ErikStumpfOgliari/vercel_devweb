# PostgreSQL — use DATABASE_URL em produção (Neon.tech)
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# JWT — gere uma string aleatória forte para produção
JWT_SECRET=soloobra-dev-secret-mude-em-producao

# Desenvolvimento local (alternativa ao DATABASE_URL)
PGDATABASE=SoloObraDB
PGUSER=postgres
PGPASSWORD=sua_senha
PGHOST=localhost
PGPORT=5432
